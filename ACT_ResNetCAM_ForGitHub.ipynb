    "\n",
    "#imagePath = \"Z:\\Archive - Former Lab Personnel\\Chad G\\Volocity Images\\hiPSC_D1-D6\"\n",
    "#imagePath = \"Z:\\Archive - Former Lab Personnel\\Chad G\\Volocity Images\\hiPSC-GJA1-D4-6\"\n",
    "folName = '26_03/'\n",
    "imagePath = 'C:/Users/aruys/Dropbox (GaTech)/CZIConverted/'+folName\n",
    "#imagePath = 'Image/hiPSC-GJA1-D4-6'\n",
    "\n",
    "def strTmpt(t):\n",
    "    if t == 1:\n",
    "        return 't001'\n",
    "    elif t < 100:\n",
    "        return 't0'+str(t)\n",
    "    else:\n",
    "        return 't'+str(t)\n",
    "\n",
    "def findNet(t):\n",
    "    tOI = strTmpt(t)\n",
    "    nets = os.listdir('ResNets_Trained/Actual')\n",
    "    for net in nets:\n",
    "        if tOI in net and not 'RdLR' in net:\n",
    "            return net\n",
    "\n",
    "label_map = {\"BMP4\" :0, \"CHIR\": 1, \"DS\": 2, \"DS+CHIR\": 3,  \"WT\": 4}\n",
    "\n",
    "input_shape = (3, 224, 224)\n",
    "# Define the number of classes\n",
    "num_classes = 5\n",
    "\n",
    "# Define the data transformations\n",
    "transform = transforms.Compose([\n",
    "    transforms.Resize(input_shape[1:]),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(mean=[0.5, 0.5, 0.5], std=[0.5, 0.5, 0.5])\n",
    "])\n",
    "\n",
    "\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "# Define the data transformations\n",
    "#I think that including this is a mistake; I need to use the other transform up above\n",
    "#that gets overridden by this.\n",
    "#To see this, compare the .png files 'TestWithDavid_WithNormTrans' and 'TestWithDavid'\n",
    "#transform = transforms.Compose([\n",
    "#    transforms.ToTensor()\n",
    "#])\n",
    "# Load the dataset\n",
    "\n",
    "#October 4, 2023 comments: change so that we choose one of Chad's two folders as our\n",
    "#root directory, not a timepoint folder like with David's data\n",
    "def get_dataloaders(joyFolder,keys,train = True):\n",
    "    dataset = MyDataset(joyFolder, keys, transform=transform)\n",
    "    \n",
    "    if train:\n",
    "        train_dataset, test_dataset = train_test_split(dataset, test_size=0.2, random_state=42)\n",
    "        # Create data loaders for train and test sets\n",
    "    \n",
    "        train_dataloader = DataLoader(train_dataset, batch_size=8, shuffle=True)\n",
    "        test_dataloader = DataLoader(test_dataset, batch_size=8, shuffle=False)\n",
    "        dataloaders = {'train': train_dataloader, 'val': test_dataloader}\n",
    "        return dataloaders\n",
    "    else:\n",
    "        test_dataloader = DataLoader(dataset, batch_size=8,shuffle = False)\n",
    "        return test_dataloader\n",
    "\n",
    "#criterion = nn.CrossEntropyLoss()\n",
    "#optimizer = optim.SGD(model.parameters(), lr=0.001, momentum=0.9)\n",
    "#optimizer = optim.Adam(model.parameters())\n",
    "#model = model.to(device)\n",
    "\n",
    "def makeCAM(model_trained, theImage, title, makeGraph = True):\n",
    "    image_array = tifffile.imread(theImage)    \n",
    "    img_rescaled = 255 * (image_array - image_array.min()) / (image_array.max() - image_array.min())\n",
    "    img_col = cv2.applyColorMap(img_rescaled.astype(np.uint8), cv2.COLORMAP_DEEPGREEN)\n",
    "    img = Image.fromarray(img_col)\n",
    "    img = img.convert(\"RGB\")\n",
    "    imt = transform(img)\n",
    "    #copied from source; let's not resize for now\n",
    "    #input_tensor = normalize(resize(img, (224, 224)) / 255., [0.5, 0.5, 0.5], [0.5, 0.5, 0.5])\n",
    "    #input_tensor = transforms.functional.normalize(imt, [0.5, 0.5, 0.5], [0.5, 0.5, 0.5])\n",
    "\n",
    "    cam_extractor = SmoothGradCAMpp(model_trained, target_layer = 'layer4')\n",
    "\n",
    "    # Preprocess your data and feed it to the model\n",
    "    out = model_trained(imt.unsqueeze(0))\n",
    "    # Retrieve the CAM by passing the class index and the model output\n",
    "    activation_map = cam_extractor(out.squeeze(0).argmax().item(), out)\n",
    "\n",
    "    if makeGraph:\n",
    "        result = overlay_mask(transforms.functional.to_pil_image(imt), transforms.functional.to_pil_image(activation_map[0].squeeze(0), mode='F'), alpha=0.5)\n",
    "        # Display it\n",
    "        plt.imshow(result); plt.axis('off'); plt.tight_layout();\n",
    "        plt.savefig(title+'.png')\n",
    "    \n",
    "    return activation_map"
   ]
