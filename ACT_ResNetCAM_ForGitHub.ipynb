    "t = 260\n",
    "\n",
    "model_trained = models.resnet18(pretrained=True)\n",
    "for param in model_trained.parameters():\n",
    "    param.requires_grad = False\n",
    "# # # Remove the last fully connected layer\n",
    "model_trained.fc = nn.Identity()\n",
    "model_trained.fc.requires_grad = True\n",
    "# Replace the last fully connected layer with a new layer that has `num_classes` output units\n",
    "model_trained.fc = nn.Linear(512, num_classes)\n",
    "model_trained.load_state_dict(torch.load('ResNets_Trained/Actual/'+findNet(t)))\n",
    "model_trained = model_trained.to(device)\n",
    "model_trained.eval()\n",
    "\n",
    "for param in model_trained.parameters():\n",
    "    param.requires_grad = True\n",
    "\n",
    "labels = ['BMP4','CHIR', 'DS', 'DS+CHIR',  'WT']"
